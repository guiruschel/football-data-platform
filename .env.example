# Environment variables template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# PostgreSQL SOURCE
POSTGRES_SOURCE_HOST=localhost
POSTGRES_SOURCE_PORT=5433
POSTGRES_SOURCE_DB=football_source
POSTGRES_SOURCE_USER=football_user
POSTGRES_SOURCE_PASSWORD=changeme

# PostgreSQL DW
POSTGRES_DW_HOST=localhost
POSTGRES_DW_PORT=5432
POSTGRES_DW_DB=football_dw
POSTGRES_DW_USER=football_user
POSTGRES_DW_PASSWORD=changeme

# Airbyte
AIRBYTE_URL=http://localhost:8000

# Airflow
AIRFLOW_UID=50000
